rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 共通関数: ログインしていて、かつリクエストされたリソースのuserIdが自分のIDと一致するか
    function isOwner() {
      return request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // 共通関数: 作成時、データ内に正しいuserIdが含まれているか
    function isValidCreate() {
      return request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // CSV取込用の決定的ID。存在しないドキュメントもTransactionで安全に確認できるよう、
    // 自分のUIDを含む取込IDに限ってgetを許可する。
    function isOwnImportDocument(documentId) {
      return request.auth != null
        && documentId.matches('import_' + request.auth.uid + '_.*');
    }

    // Wallets collection
    match /wallets/{walletId} {
      allow read, update, delete: if isOwner();
      allow create: if isValidCreate();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read, update, delete: if isOwner();
      allow create: if isValidCreate();
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow get: if isOwner() || isOwnImportDocument(transactionId);
      allow list, update, delete: if isOwner();
      allow create: if isValidCreate()
        && (!transactionId.matches('import_.*') || isOwnImportDocument(transactionId));
    }
  }
}
